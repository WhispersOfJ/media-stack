[Unit]
Description=Sweep Plex Anime-tagged Movies into the Anime Movies library via Radarr
After=media-stack.service
# Same defense-in-depth as every other stack-*.service unit.
OnFailure=notify-failure@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/Stack
ExecStart=/usr/bin/python3 %h/Stack/scripts/sort-anime-movies.py
