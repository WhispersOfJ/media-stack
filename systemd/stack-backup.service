[Unit]
Description=Stack config backup (restic)
After=media-stack.service
# Defense-in-depth: catches failures the script itself can't self-report
# (OOM-killed, systemd timeout, exec failure before the script even runs).
# The script's own success/failure notification (see notify-discord.sh
# calls in backup-config.sh) is the primary signal for a normal failure.
OnFailure=notify-failure@%n.service

[Service]
Type=oneshot
WorkingDirectory=/home/bear/Claude/media-stack
ExecStart=/home/bear/Claude/media-stack/scripts/backup-config.sh
