[Unit]
Description=Media Stack (Docker Compose, extras profile)
# Zurg and rclone-AllDebrid are containerized (zurg/rclone-alldebrid services
# in docker-compose.yml) as of the Phase 1 containerization - no host-level
# zurg.service/rclone-all.service dependency needed anymore; compose brings
# them up itself, in the same tier as every other container.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%h/Stack
ExecStart=/usr/bin/docker compose --profile extras up -d
ExecStop=/usr/bin/docker compose --profile extras down
TimeoutStartSec=300

[Install]
WantedBy=default.target
