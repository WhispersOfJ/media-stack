[Unit]
Description=Media Stack (Docker Compose, extras profile)
# zurg.service mounts /mnt/zurg itself (via its own embedded rclone process);
# rclone-all.service mounts /mnt/all separately. Both are bind-mounted rslave
# into every arr container's /mnt, so they must be live before compose starts
# or the containers see empty directories instead of the debrid content.
After=network-online.target zurg.service rclone-all.service
Wants=network-online.target
Requires=zurg.service rclone-all.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%h/Stack
ExecStart=/usr/bin/docker compose --profile extras up -d
ExecStop=/usr/bin/docker compose --profile extras down
TimeoutStartSec=300

[Install]
WantedBy=default.target
