[Unit]
Description=Hourly sweep of Anime-tagged Movies into the Anime Movies library

[Timer]
# Hourly keeps staleness (an Anime-tagged movie sitting in the wrong
# library between imports) capped at under an hour - the whole reason this
# runs on a short timer instead of daily like stack-imdb-sync.timer.
OnBootSec=10min
OnUnitActiveSec=1h

[Install]
WantedBy=timers.target
