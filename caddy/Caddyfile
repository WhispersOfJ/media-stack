# Single entry point in front of every service's web UI. Each site block
# below listens on the exact host port that service used to publish
# directly, so bookmarks/URLs are unchanged - only the auth gate is new.
# HTTP only, no TLS: this stack is LAN-only (see README's Security section
# for what this does and doesn't defend against).
{
	auto_https off
}

(auth) {
	basic_auth {
		{$CADDY_BASIC_AUTH_USER} {$CADDY_BASIC_AUTH_HASH}
	}
}

:9696 {
	import auth
	reverse_proxy prowlarr:9696
}

:8181 {
	import auth
	reverse_proxy zilean:8181
}

:8282 {
	import auth
	reverse_proxy decypharr:8282
}

