# ---- Identity / runtime ----
PUID=1000
PGID=1000
TZ=America/New_York

# ---- Networking ----
# Host IP this stack runs on
HOST_IP=192.168.4.105

# ---- Zilean / Postgres ----
# Generate with: python3 -c "import secrets; print(secrets.token_hex(16))"
# ZILEAN_POSTGRES_PASSWORD is also read by Control Panel (read-only hash-count stat tile)
ZILEAN_POSTGRES_PASSWORD=changeme
ZILEAN_API_KEY=changeme

# ---- Plex ----
# Token: Settings -> a library item -> Get Info -> View XML, or see
# https://support.plex.tv/articles/204059436
PLEX_URL=http://192.168.4.105:32400
PLEX_TOKEN=changeme

# ---- Watchtower (Discord notifications via Shoutrrr) ----
# Shoutrrr Discord URL format: discord://<webhook_token>@<webhook_id>
# (from a Discord webhook URL https://discord.com/api/webhooks/<id>/<token>)
DISCORD_WATCHTOWER_SHOUTRRR_URL=changeme

# ---- Alerting (shared by backup script + container-health watcher) ----
DISCORD_WEBHOOK_URL=changeme

# ---- Off-site backup (optional) ----
# Local-disk backup (~/backups/stack-restic-repo) is the only copy unless this
# is set - see README's "Known limitation" note. Left blank on purpose (not
# "changeme") - blank means "skip the remote leg entirely", not "still needs
# filling in". Any restic-supported repository URL works (b2:, s3:, sftp:,
# rclone:, etc.) - see https://restic.readthedocs.io/en/stable/030_preparing_a_new_repo.html.
# Needs its own provider credentials too (e.g. B2_ACCOUNT_ID/B2_ACCOUNT_KEY,
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY) - add those here as well if used,
# restic reads them from the environment same as any other var below.
BACKUP_REMOTE_REPOSITORY=
BACKUP_REMOTE_PASSWORD_FILE=

# ---- Control Panel (*arr API keys) ----
# Each app's Settings -> General -> Security -> API Key
RADARR_API_KEY=changeme
SONARR_API_KEY=changeme
BAZARR_API_KEY=changeme

# ---- DebridMediaManager (self-hosted) ----
# Generate with: python3 -c "import secrets; print(secrets.token_hex(16))"
DMM_MYSQL_ROOT_PASSWORD=changeme
DMM_MYSQL_PASSWORD=changeme
DMMCAST_SALT=changeme
# Origin the app is served at - used for building its own callback/share URLs
DMM_ORIGIN=http://192.168.4.105:3000
# Required in practice, not just "optional" like upstream's own .env.example implies - the
# scraper can't identify a title without these, so search/scrape won't work without them.
# If Kometa is already configured (config/kometa/config.yml), its tmdb/mdblist/omdb/trakt/
# github keys can be reused here directly instead of signing up again. Otherwise, free
# signups: https://www.themoviedb.org/settings/api and https://mdblist.com/preferences
TMDB_KEY=changeme
MDBLIST_KEY=changeme
# Genuinely optional - supplemental metadata only. Free tier: https://www.omdbapi.com/apikey.aspx
OMDB_KEY=changeme
# Genuinely optional - Trakt watchlist/collection sync. https://trakt.tv/oauth/applications
TRAKT_CLIENT_ID=changeme
TRAKT_CLIENT_SECRET=changeme
# Genuinely optional - GitHub API rate-limit relief only, unrelated to the OAuth-login/
# sponsor-tier providers (deliberately not wired up, see CHANGELOG v6.2.0).
GH_PAT=changeme
