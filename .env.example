# ---- Identity / runtime ----
PUID=1000
PGID=1000
TZ=America/New_York

# ---- Networking ----
# Host IP this stack runs on
HOST_IP=192.168.4.105

# ---- Plex ----
# Token: Settings -> a library item -> Get Info -> View XML, or see
# https://support.plex.tv/articles/204059436
PLEX_URL=http://192.168.4.105:32400
PLEX_TOKEN=changeme
# Port scripts/plex-webhook-listener.py binds on 127.0.0.1 for Plex's own
# native webhook (Settings -> Webhooks in the Plex web app, Plex Pass
# required - add http://127.0.0.1:<this port>/plex-webhook there by hand,
# see README). Not exposed beyond localhost; nothing but Plex needs to
# reach it, and Plex runs with network_mode: host so localhost is shared.
PLEX_WEBHOOK_PORT=9880

# ---- Watchtower (Discord notifications via Shoutrrr) ----
# Shoutrrr Discord URL format: discord://<webhook_token>@<webhook_id>
# (from a Discord webhook URL https://discord.com/api/webhooks/<id>/<token>)
DISCORD_WATCHTOWER_SHOUTRRR_URL=changeme

# ---- Alerting (shared by notification scripts + container-health watcher) ----
DISCORD_WEBHOOK_URL=changeme

# ---- Control Panel (*arr API keys) ----
# Each app's Settings -> General -> Security -> API Key
RADARR_API_KEY=changeme
SONARR_API_KEY=changeme
PROWLARR_API_KEY=changeme
# radarr_anime instance's own API key (separate Radarr container/instance)
RADARR_ANIME_API_KEY=changeme
RADARR_ANIME_URL=http://localhost:7879
# sonarr_anime instance's own API key (separate Sonarr container/instance)
SONARR_ANIME_API_KEY=changeme
SONARR_ANIME_URL=http://localhost:8990

# Control Panel's own auth (session login + service-to-service calls)
CONTROL_PANEL_SECRET_KEY=changeme
CONTROL_PANEL_ADMIN_USERNAME=admin
CONTROL_PANEL_ADMIN_PASSWORD=changeme
# Shared key other services use to call Control Panel's API (X-Api-Key header)
CONTROL_PANEL_SERVICE_API_KEY=changeme

# Control Panel's own TMDb lookups (e.g. /api/plex/tmdb-missing) - v3 API key.
# Free signup: https://www.themoviedb.org/settings/api
TMDB_KEY=changeme

# Control Panel's /api/ratings/imdb and /api/ratings/mdblist.
# Free signup: https://www.omdbapi.com/apikey.aspx
OMDB_KEY=changeme
# Free signup: https://mdblist.com/api/
MDBLIST_KEY=changeme

# Control Panel's poster sync (/api/posters/sync, source="fanart") - v3 API key.
# Free signup: https://fanart.tv/get-an-api-key/
FANART_KEY=changeme

# Control Panel's poster sync (/api/posters/sync, source="tvdb") - v4 project
# API key. Signup: https://thetvdb.com/api-information
TVDB_KEY=changeme

# ---- Usenet (block-account news server, via NzbDAV) ----
# NzbDAV (nzbdav-dev) removed entirely 2026-07-23 (unmerged connection-leak
# bug), then AltMount removed entirely 2026-07-24 (cutover to BearMount, the
# rebranded fork), then BearMount removed entirely 2026-07-28 (cutover to
# nzbdav/nzbdav, the "super-fork" - see STACK.md's History for all three).
# NzbDAV's headless NZBDAV_CONFIG__... env vars ARE the source of truth for
# these values (see docker-compose.yml's nzbdav service) - unlike BearMount,
# there is no separate config.yaml; update only here if these ever change.
NZBDAV_USENET_HOST=changeme
NZBDAV_USENET_PORT=563
NZBDAV_USENET_USER=changeme
NZBDAV_USENET_PASS=changeme
# Second (backup) usenet provider - NzbDAV's Providers array carries both as
# separate entries (see docker-compose.yml's NZBDAV_CONFIG__USENET__PROVIDERS)
# so a missing/degraded segment on the primary can still be served.
NZBDAV_USENET_BACKUP_HOST=changeme
NZBDAV_USENET_BACKUP_PORT=563
NZBDAV_USENET_BACKUP_USER=changeme
NZBDAV_USENET_BACKUP_PASS=changeme
# WebDAV user/pass NzbDAV's own WebDAV server authenticates as (also what the
# nzbdav_rclone sidecar uses to mount it)
NZBDAV_WEBDAV_USER=usenet
NZBDAV_WEBDAV_PASS=changeme
# Shared frontend<->backend proxy auth key; mirrored into
# NZBDAV_CONFIG__API__KEY so *Arr/SAB and the Settings UI agree on one key.
FRONTEND_BACKEND_API_KEY=changeme
# rclone RC (remote control) password for the nzbdav_rclone sidecar's cache-refresh notifications
NZBDAV_RCLONE_RC_PASS=changeme
# Bearer token for InfiniDysk's own search-profile adapter URLs (Newznab/Addon/JSON) -
# used by Watchdog/Preflight/Watchtower's own Indexers+Profile subsystem, added
# 2026-08-11. Distinct from FRONTEND_BACKEND_API_KEY.
NZBDAV_PROFILE_TOKEN=changeme

# ---- new-services (2026-08) - see PLANS.md for the full 7-service spec ----
# Phase 2: Speedtest Tracker. Laravel APP_KEY, generate once via
# `echo "base64:$(openssl rand -base64 32)"` (see PLANS.md Phase 2.2 /
# docs.speedtest-tracker.dev/getting-started/installation/using-docker) -
# do not rotate after first boot without re-encrypting any stored data.
SPEEDTEST_TRACKER_APP_KEY=changeme
# Admin account seeded on first boot only (ADMIN_NAME/EMAIL/PASSWORD env
# vars are "only effective during initial setup" per upstream docs) - set
# these instead of leaving the upstream default admin@example.com/password.
SPEEDTEST_TRACKER_ADMIN_EMAIL=changeme
SPEEDTEST_TRACKER_ADMIN_PASSWORD=changeme
# Sanctum API token, minted once post-boot by inserting a row directly into
# the bind-mounted sqlite DB (see STACK.md's Speedtest Tracker entry - the
# image ships without `artisan tinker`, and Sanctum only ever stores a hash
# of this token, so it can't be read back out; this is the only copy of the
# plaintext).
SPEEDTEST_TRACKER_API_TOKEN=changeme

# Phase 3: Organizr. Single landing dashboard; provisioned entirely by
# scripts/organizr-provision.py (wizard + tabs), so these must be set
# BEFORE the first `docker compose up -d organizr`.
# API key must be EXACTLY 20 characters - Organizr's isApprovedRequest()
# (api/classes/organizr.class.php:4609) gates on `strlen($token) == 20`,
# so a longer or shorter key silently 401s every write route.
# Generate: python3 -c "import secrets,string;print(''.join(secrets.choice(string.ascii_letters+string.digits) for _ in range(20)))"
ORGANIZR_API_KEY=changeme
# Encryption key Organizr stores as `organizrHash` in its config.php and
# uses to derive its cookie name. Any length; 32 chars is what this stack uses.
ORGANIZR_HASH_KEY=changeme
# First admin, created by the wizard call. There is no default login to
# change afterwards - the account does not exist until provisioning runs.
ORGANIZR_ADMIN_USERNAME=changeme
ORGANIZR_ADMIN_EMAIL=changeme
ORGANIZR_ADMIN_PASSWORD=changeme
# Required by the wizard payload even though self-registration stays off.
ORGANIZR_REGISTRATION_PASSWORD=changeme
