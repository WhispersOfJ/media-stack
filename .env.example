# ---- Identity / runtime ----
PUID=1000
PGID=1000
TZ=America/New_York

# ---- Networking ----
# Host IP this stack runs on
HOST_IP=192.168.4.105

# ---- Plex ----
# Token: Settings -> a library item -> Get Info -> View XML, or see
# https://support.plex.tv/articles/204059436
PLEX_URL=http://192.168.4.105:32400
PLEX_TOKEN=changeme
# Port scripts/plex-webhook-listener.py binds on 127.0.0.1 for Plex's own
# native webhook (Settings -> Webhooks in the Plex web app, Plex Pass
# required - add http://127.0.0.1:<this port>/plex-webhook there by hand,
# see README). Not exposed beyond localhost; nothing but Plex needs to
# reach it, and Plex runs with network_mode: host so localhost is shared.
PLEX_WEBHOOK_PORT=9880

# ---- Watchtower (Discord notifications via Shoutrrr) ----
# Shoutrrr Discord URL format: discord://<webhook_token>@<webhook_id>
# (from a Discord webhook URL https://discord.com/api/webhooks/<id>/<token>)
DISCORD_WATCHTOWER_SHOUTRRR_URL=changeme

# ---- Alerting (shared by backup script + container-health watcher) ----
DISCORD_WEBHOOK_URL=changeme

# ---- Off-site backup (optional) ----
# Local-disk backup (~/backups/stack-restic-repo) is the only copy unless this
# is set - see README's "Known limitation" note. Left blank on purpose (not
# "changeme") - blank means "skip the remote leg entirely", not "still needs
# filling in". Any restic-supported repository URL works (b2:, s3:, sftp:,
# rclone:, etc.) - see https://restic.readthedocs.io/en/stable/030_preparing_a_new_repo.html.
# Needs its own provider credentials too (e.g. B2_ACCOUNT_ID/B2_ACCOUNT_KEY,
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY) - add those here as well if used,
# restic reads them from the environment same as any other var below.
BACKUP_REMOTE_REPOSITORY=
BACKUP_REMOTE_PASSWORD_FILE=

# ---- Control Panel (*arr API keys) ----
# Each app's Settings -> General -> Security -> API Key
RADARR_API_KEY=changeme
SONARR_API_KEY=changeme
PROWLARR_API_KEY=changeme

# Control Panel's own TMDb lookups (e.g. /api/plex/tmdb-missing) - v3 API key.
# Free signup: https://www.themoviedb.org/settings/api
TMDB_KEY=changeme

# Control Panel's /api/ratings/imdb and /api/ratings/mdblist - used to be
# read live off Kometa's own config.yml, now standalone secrets since
# Kometa was removed entirely (no Jellyfin support - see CLAUDE.md).
# Free signup: https://www.omdbapi.com/apikey.aspx
OMDB_KEY=changeme
# Free signup: https://mdblist.com/api/
MDBLIST_KEY=changeme

# ---- Usenet (block-account news server, via AltMount) ----
# NzbDAV was removed entirely 2026-07-23 (unmerged connection-leak bug,
# nzbdav-dev/nzbdav#478 - see CLAUDE.md's History). AltMount stores all of
# this in its own config/altmount/config.yaml, not docker-compose
# environment substitution - these are documented here as the source of
# truth only. Update both places if this ever changes.
ALTMOUNT_PROVIDER_HOST=changeme
ALTMOUNT_PROVIDER_PORT=563
ALTMOUNT_PROVIDER_USERNAME=changeme
ALTMOUNT_PROVIDER_PASSWORD=changeme
# WebDAV user/pass AltMount's own config.yaml (webdav section) authenticates as
ALTMOUNT_WEBDAV_USER=usenet
ALTMOUNT_WEBDAV_PASSWORD=changeme
ALTMOUNT_JWT_SECRET=changeme
# Admin account registered via AltMount's own /api/auth/register (first-run
# only) - used for its web UI and REST API, unrelated to the WebDAV creds above.
ALTMOUNT_ADMIN_PASSWORD=changeme
# Real API key issued at registration (POST /api/auth/register) - what
# Radarr/Sonarr's download client and control-panel both authenticate with.
ALTMOUNT_API_KEY=changeme
